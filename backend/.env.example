# Copy to backend/.env (git-ignored). Never commit real secrets.
ENV=development

# Postgres. Locally this matches docker-compose.yml (host port 5433 avoids clashing with a local Postgres). On Railway, DATABASE_URL is provided.
DATABASE_URL=postgresql://baker:baker@localhost:5433/baker

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://the-baker-.*\.vercel\.app

# Created at startup if no owner exists yet
FIRST_OWNER_EMAIL=owner@demo.thebaker
FIRST_OWNER_PASSWORD=change-this-password
FIRST_OWNER_NAME=Baker Owner

# Store
CURRENCY=EGP
BUSINESS_NAME=The Baker

# Product photos: "local" for development, "r2" (Cloudflare R2) in production.
STORAGE_BACKEND=local
# PUBLIC_API_URL=http://localhost:8000
# When STORAGE_BACKEND=r2, all of these are required:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev   # public bucket URL or custom domain, no trailing slash

# Loads ~30 demo products (idempotent, only if the catalog is empty)
SEED_DEMO=true

# ---- Payments (M4) ----
# paymob = real card payments through Paymob (Egypt), using test keys until you go live.
# fake   = a practice payment page for development and demos (refused in production).
# none   = cash only.
PAYMENT_PROVIDER=fake
# Needed when PAYMENT_PROVIDER=paymob (Paymob dashboard: Settings, API Keys / Payment Integrations):
# PAYMOB_SECRET_KEY=egy_sk_test_...
# PAYMOB_PUBLIC_KEY=egy_pk_test_...
# PAYMOB_HMAC_SECRET=...
# PAYMOB_INTEGRATION_ID=1234567
# Paymob calls this address after each payment, so it must be reachable from the internet
# (your Railway URL, no trailing slash). Leave it unset for local development.
# PUBLIC_API_URL=https://your-backend.up.railway.app

# ---- Email (M4) ----
# Without a key, emails are only written to the server log. With Resend, EMAIL_FROM must use a
# domain you verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
# RESEND_API_KEY=re_...
# EMAIL_FROM=The Baker <orders@yourdomain.com>
